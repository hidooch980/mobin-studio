<?xml version="1.0" encoding="utf-8"?>
<!-- Mobin Studio for Android: one WebView showing the same app as the Windows version.
     versionCode / versionName / min+target SDK are passed by build.sh (aapt2 link). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.nerdcity.mobinstudio">

  <!-- the app itself works offline; WebView simply behaves best with this one -->
  <uses-permission android:name="android.permission.INTERNET"/>
  <uses-permission android:name="android.permission.VIBRATE"/>
  <!-- only Android 9 and older need it to put pictures in the gallery -->
  <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="28"/>
  <!-- the in-app "دانلود و نصب" button hands the new APK to the system installer;
       the user still confirms the install in the system dialog -->
  <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES"/>
  <uses-feature android:name="android.hardware.touchscreen" android:required="false"/>

  <application
      android:label="@string/app_name"
      android:icon="@mipmap/ic_launcher"
      android:roundIcon="@mipmap/ic_launcher_round"
      android:theme="@style/AppTheme"
      android:hardwareAccelerated="true"
      android:largeHeap="true"
      android:allowBackup="false"
      android:supportsRtl="true"
      android:resizeableActivity="true">

    <activity android:name=".MainActivity"
        android:exported="true"
        android:launchMode="singleTask"
        android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|density|uiMode|fontScale|locale|layoutDirection"
        android:windowSoftInputMode="adjustResize">
      <intent-filter>
        <action android:name="android.intent.action.MAIN"/>
        <category android:name="android.intent.category.LAUNCHER"/>
      </intent-filter>
      <!-- open a .mobin project from a file manager / Telegram / Downloads -->
      <intent-filter>
        <action android:name="android.intent.action.VIEW"/>
        <category android:name="android.intent.category.DEFAULT"/>
        <category android:name="android.intent.category.BROWSABLE"/>
        <data android:scheme="content"/>
        <data android:scheme="file"/>
        <data android:mimeType="application/x-mobin"/>
        <data android:mimeType="application/vnd.mobin"/>
        <!-- Telegram and most file managers call unknown files "octet-stream" -->
        <data android:mimeType="application/octet-stream"/>
      </intent-filter>
      <intent-filter>
        <action android:name="android.intent.action.VIEW"/>
        <category android:name="android.intent.category.DEFAULT"/>
        <category android:name="android.intent.category.BROWSABLE"/>
        <data android:scheme="content"/>
        <data android:scheme="file"/>
        <data android:host="*"/>
        <data android:mimeType="*/*"/>
        <data android:pathPattern=".*\\.mobin"/>
        <data android:pathPattern=".*\\..*\\.mobin"/>
        <data android:pathPattern=".*\\..*\\..*\\.mobin"/>
        <data android:pathPattern=".*\\..*\\..*\\..*\\.mobin"/>
      </intent-filter>
      <intent-filter>
        <action android:name="android.intent.action.VIEW"/>
        <category android:name="android.intent.category.DEFAULT"/>
        <category android:name="android.intent.category.BROWSABLE"/>
        <data android:scheme="content"/>
        <data android:scheme="file"/>
        <data android:host="*"/>
        <data android:pathPattern=".*\\.mobin"/>
        <data android:pathPattern=".*\\..*\\.mobin"/>
        <data android:pathPattern=".*\\..*\\..*\\.mobin"/>
        <data android:pathPattern=".*\\..*\\..*\\..*\\.mobin"/>
      </intent-filter>
    </activity>

    <!-- hands the downloaded update APK to the system installer.
         Not exported: only this app can grant the installer a read on it. -->
    <provider android:name=".ApkProvider"
        android:authorities="com.nerdcity.mobinstudio.apk"
        android:exported="false"
        android:grantUriPermissions="true"
        android:directBootAware="false"/>
  </application>
</manifest>
